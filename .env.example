DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=bookstore
DB_USER=bookstore
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DJANGO_FORCE_HTTPS=0
FIELD_ENCRYPTION_KEY=


# Checkout (issue #9). Card data is never stored; "sandbox" is for development and demos only.
PAYMENT_GATEWAY=sandbox
CHECKOUT_TAX_RATE=0.05
CHECKOUT_SHIPPING_FLAT=50.00

# Admin verification email (use a TLS-enabled SMTP service; never commit real credentials).
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=bookstore@example.com

# Customer support inbox shown on every page (NFR-12).
SUPPORT_EMAIL=support@example.com

# Payment gateway: "sandbox" (default, offline demo card) or "stripe" (Stripe Checkout hosted page).
PAYMENT_GATEWAY=sandbox
# Test-mode secret key from the Stripe dashboard (sk_test_...). Never commit a real key.
STRIPE_SECRET_KEY=
