DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=bookstore
DB_USER=bookstore
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Checkout (issue #9). Card data is never stored; "sandbox" is for development and demos only.
PAYMENT_GATEWAY=sandbox
CHECKOUT_TAX_RATE=0.05
CHECKOUT_SHIPPING_FLAT=50.00

# Admin verification email (use a TLS-enabled SMTP service; never commit real credentials).
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=bookstore@example.com
